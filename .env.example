NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta exigida para criar contas admin/staff em /auth/register-admin.
# Gere um valor forte e único por ambiente (ex: openssl rand -base64 18) e nunca reutilize entre dev/prod.
ADMIN_SIGNUP_SECRET=

# Segredo usado para autorizar chamadas ao endpoint de automações agendadas (/api/admin/automations/run).
# Configure o mesmo valor no cron externo (ex: cron-job.org, GitHub Actions, Vercel Cron) que dispara o endpoint.
AUTOMATIONS_CRON_SECRET=
